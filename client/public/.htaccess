Options -MultiViews
RewriteEngine On
RewriteBase /

# ALEX Inbox: never expose server-side secrets or private workflow state.
<FilesMatch "^\.alex-inbox-(config\.php|state\.json)$">
  Require all denied
</FilesMatch>


# Canonical redirect: www -> non-www (fixes Google duplicate content)
RewriteCond %{HTTP_HOST} ^www\.intelligentforce\.ai [NC]
RewriteRule ^(.*)$ https://intelligentforce.ai/$1 [R=301,L]

# Allow direct access to /videos/ directory (mp4, webm)
RewriteRule ^videos/ - [L]

# Allow direct access to /blog/ directory (images)
RewriteRule ^blog/ - [L]

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else to index.html (React SPA)
RewriteRule ^ index.html [L]

# No cache for index.html
<FilesMatch "index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Long cache for hashed assets
<FilesMatch "\.(js|css|png|jpg|jpeg|svg|woff2|webp|pdf)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Cache for video files
<FilesMatch "\.(mp4|webm|mov|ogg)$">
  Header set Cache-Control "public, max-age=86400"
  Header set Accept-Ranges "bytes"
</FilesMatch>
